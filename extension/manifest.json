{
  "manifest_version": 3,
  "name": "Ola ChatGPT Webhook",
  "version": "1.0.0",
  "description": "Reads ChatGPT assistant responses and sends completed responses to the Ola webhook.",
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://ola.v1noid.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
